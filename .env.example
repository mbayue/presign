# Copy to .env and fill in. Never commit .env.

# Discord bot token (required for the bot, not for `bun run scan`)
DISCORD_TOKEN=

# OpenAI-compatible AI endpoint for the plain-language summary (optional)
AI_API_KEY=
AI_BASE_URL=https://api.vultrinference.com/v1
AI_MODEL=minimax-m3.1-flash
AI_FALLBACK_MODEL=mimo-v2.6-flash

# Optional Helius key (only used by the optional program-name enrichment)
HELIUS_API_KEY=

# Cluster used when a link carries no ?cluster= parameter: mainnet or devnet
SCAN_DEFAULT_CLUSTER=mainnet

# Public key passed to link servers and simulated as the signer. The bot holds no key for it.
# Default is an off-curve address, so no private key can exist. For demos, set a funded devnet address.
SCAN_PLACEHOLDER_ACCOUNT=Hzhu1o57ZuQaPJdHMqbG2aKWHcuJNWARvQMzydsFWKK7

# RPC endpoint overrides (defaults are the public endpoints)
SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com

# Extra program IDs to treat as known (comma-separated)
SCAN_EXTRA_KNOWN_PROGRAMS=
